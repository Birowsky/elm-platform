{
  "manifest_version": 3,
  "name": "Stagger Tuner",
  "version": "0.1.0",
  "description": "Loops the staggered entrance of an [ef-stagger] list and tunes its curves, durations and start pose while it plays.",
  "minimum_chrome_version": "123",
  "action": {
    "default_title": "Stagger Tuner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
